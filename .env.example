# Copie para .env e preencha SE for usar os backends de LLM na comparação de modelos.
# O núcleo (motor + avaliação + baseline offline) roda SEM nenhuma destas variáveis.

# --- Backend Claude (opcional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Backend Ollama (opcional, modelo local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ATENÇÃO: NÃO coloque aqui tokens do Garmin nem credenciais de saúde.
# Este projeto NÃO acessa a conta do Garmin; ele consome dados já exportados/estruturados.
